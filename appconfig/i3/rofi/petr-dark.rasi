* {
  background-color: transparent;
  text-color: #FFFFFFFF;
  spacing: 4;
  font: "Monospace 25";
}

window {
  width: 100%;
  height: 65%;
  background-color: #292929BD;
  transpacency: "real";
}

mainbox {
  margin: 14%;
  padding: 10px 20px 0 20px;
}

inputbar {
  padding: 20px;
  children: [ textbox-prompt-semicolon, entry, case-indicator ];
  border: 0px 0px 2px 0px;
  border-color: #AADDFFFF;
}

textbox-prompt-semicolon {
  text-color: #AABBFF;
  expand: false;
  str: "> ";
  spacing: 10px;
  font: "Monospace 30";
  padding: -7px;
}

listview {
  padding: 25px 0px 0px 0px;
}

element{
  padding: 0.42%;
}

element selected {
  background-color: #8AC0FF70;
  text-color: #FFFFFFFF;
  border: 1px;
  border-color: #AADDFFFF;
}

