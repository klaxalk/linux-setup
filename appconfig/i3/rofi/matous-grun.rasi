* {
  background-color: transparent;
  text-color: #FFFFFFFF;
  spacing: 4;
  font: "Monospace 15";
}

window {
  width: 100%;
  height: 65%;
  background-color: #32322FED;
  transpacency: "real";
}

mainbox {
  margin: 14%;
  padding: 10px 20px 0 20px;
}

inputbar {
  padding: 10px;
  children: [ textbox-prompt-semicolon, entry, case-indicator ];
  border: 0px 0px 2px 0px;
  border-color: #CAE682FF;
}

textbox-prompt-semicolon {
  text-color: #CAE682FF;
  expand: false;
  str: "> ";
  spacing: 10px;
  font: "Monospace 24";
  padding: -8px;
}

listview {
  padding: 25px 0px 0px 0px;
}

element{
  padding: 0.22%;
}

element selected {
  background-color: #242424ED;
  text-color: #FFFFFFFF;
  border: 1px;
  border-color: #CAE682FF;
}

