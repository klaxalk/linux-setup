{
  "[c][cpp]":{
    "semanticTokens.enable": true
  },
  "clangd.enabled": true,
  "clangd.arguments": ["-header-insertion=never"],
  "clangd.compilationDatabaseCandidates": ["${cwd}", "${workspaceFolder}", "${workspaceFolder}/build", "${env:ROS_WORKSPACE}/build"],
  "signature.preferShownAbove": true,
  "suggest.detailField": "preview",
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "workspace.workspaceFolderFallbackCwd": false,
  "workspace.rootPatterns": [],
  "snippets.priority": 200,
  "snippets.ultisnips.pythonPrompt": false
}
